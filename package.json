{
	"name": "tools",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier . --write . --cache",
		"lint": "oxlint . -W perf -W suspicious --vitest-plugin",
		"test:unit": "vitest --coverage",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@iconify-json/tabler": "^1.2.37",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@tiptap/extension-color": "^3.28.0",
		"@tiptap/extension-font-family": "^3.28.0",
		"@tiptap/extension-text-style": "^3.28.0",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"file-type": "^22.0.1",
		"jsdom": "^29.1.1",
		"oxlint": "^1.75.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"dependencies": {
		"@tiptap/core": "^3.28.0",
		"@tiptap/extension-placeholder": "^3.28.0",
		"@tiptap/pm": "^3.28.0",
		"@tiptap/starter-kit": "^3.28.0",
		"bits-ui": "^2.18.1",
		"html2canvas-pro": "^2.3.0",
		"idb": "^8.0.3",
		"modern-screenshot": "^4.7.0",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-highlight": "^7.11.0",
		"tippy.js": "^6.3.7",
		"typescript-color-gradient": "^4.2.0"
	},
	"resolutions": {
		"prosemirror-model": "1.25.11"
	}
}
