		"unplugin-icons": "^22.2.0",
		"vite": "^7.0.6",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"dependencies": {
		"@tiptap/core": "^3.0.9",
		"@tiptap/extension-placeholder": "^3.0.9",
		"@tiptap/pm": "^3.0.9",
		"@tiptap/starter-kit": "^3.0.9",
		"bits-ui": "^2.9.1",
		"idb": "^8.0.3",
		"svelte-awesome-color-picker": "^4.0.2",
		"tippy.js": "^6.3.7",
		"typescript-color-gradient": "^4.0.1"
	}
