{
    "name": "tools",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier . --write . --cache",
        "lint": "oxlint . -W perf -W suspicious --vitest-plugin",
        "test:unit": "vitest --coverage",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "test:e2e": "playwright install && playwright test"
    },
    "devDependencies": {
        "@iconify-json/tabler": "^1.2.42",
        "@playwright/test": "^1.64.0",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/sortablejs": "^1.15.9",
        "@vitest/coverage-v8": "5.0.3",
        "@vitest/ui": "^5.0.3",
        "file-type": "^22.1.1",
        "oxlint": "^1.87.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "type": "module",
    "dependencies": {
        "@chenglou/pretext": "^0.0.9",
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-color": "^3.31.4",
        "@tiptap/extension-font-family": "^3.31.4",
        "@tiptap/extension-placeholder": "^3.31.4",
        "@tiptap/extension-text-style": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "idb": "^8.0.4",
        "modern-screenshot": "^4.7.0",
        "sortablejs": "^1.15.7",
        "svelte-awesome-color-picker": "^4.1.3",
        "svelte-highlight": "^7.23.1",
        "tippy.js": "^6.3.7",
        "typescript": "^6.0.3",
        "typescript-color-gradient": "^4.2.0"
    },
    "overrides": {
        "prosemirror-model": "1.25.11"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
